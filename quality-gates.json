{
  "schema_version": 1,
  "language": "python and typescript",
  "gates": {
    "lint": {
      "command": "python -m ruff check src scripts tests",
      "not_applicable_reason": null
    },
    "format": {
      "command": "python -m ruff format --check src scripts tests",
      "not_applicable_reason": null
    },
    "type_check": {
      "command": "python -m pyright",
      "not_applicable_reason": null
    },
    "tests": {
      "command": "python -m unittest discover -s tests -v",
      "not_applicable_reason": null
    }
  },
  "local_check_command": "python scripts/check_project.py",
  "ci_workflow": ".github/workflows/ci.yml",
  "frontend": {
    "root": "web",
    "lint": "npm run lint --prefix web",
    "format": "npm run lint --prefix web",
    "type_check": "npm run typecheck --prefix web",
    "build": "npm run build --prefix web",
    "tests": "npm run test:browser --prefix web",
    "shared_suite": "python scripts/check_project.py --suite web"
  }
}
