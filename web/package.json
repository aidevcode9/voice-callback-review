{
  "name": "voice-callback-review-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "biome check --config-path=. app lib tests playwright.config.ts",
    "format": "biome check --config-path=. --write app lib tests playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript ../docs/api/openapi.json -o lib/api.generated.ts",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
