# Copy this file to the repository root as .env for optional local tracing.
# Process environment values override .env, including explicitly empty values.
# Values are literal; quotes do not expand escapes or shell variables.
VCR_LANGFUSE_ENABLED=0
# Enabled tracing sends transcript and validated decision content by default.
# Set VCR_LANGFUSE_CONTENT=0 to send metadata only.
VCR_LANGFUSE_CONTENT=1
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
